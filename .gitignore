# Secrets. .env.example is the committed template; anything with real values
# stays out of the repo.
.env
.env.*
!.env.example

# The Android app's signing key, its passwords, and Firebase's files, wherever
# they end up. android/.gitignore covers its own folder; these catch a key
# saved anywhere else in the repository by mistake.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
google-services.json
*firebase-adminsdk*.json

# release/<version>/uwuhere-<version>.apk is built by android/build-apk.ps1
# and committed, so nothing under release/ is ignored.

# Vercel
.vercel

# Local tooling
node_modules/
*.log

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
