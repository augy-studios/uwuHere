# uwuHere environment variables
#
# Set these in the Vercel dashboard: Project, Settings, Environment
# Variables. For `vercel dev`, copy this file to .env.local and fill it in.
# Never commit a filled-in copy: .env and .env.* are in .gitignore.
#
# All of them are server side only. None of them is ever sent to a browser.
# The first five run the site; the last three are for the Android app.


# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The shared uwuapps Supabase project. Run migrations/0001 and 0002 from the
# repository root in its SQL editor first.
#
# The service role key bypasses row level security, which is how the API
# reaches the uwuhere_ tables. Treat it as a password.
#
# Required. Without them every /api call answers 503.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=


# ---------------------------------------------------------------------------
# Host keys
# ---------------------------------------------------------------------------
# Signs the key that lets a browser manage an event (api/_lib/auth.js).
# Generate one with:  openssl rand -hex 32
#
# Required. Changing it signs every host out of every open event; a host who
# set a password can get back in with it. Set it once and leave it.

UWUHERE_HOST_SECRET=


# ---------------------------------------------------------------------------
# Password pepper
# ---------------------------------------------------------------------------
# Mixed into every event password before bcrypt (api/_lib/auth.js), and kept
# here rather than in the database, so a leaked table cannot be cracked
# without it. Generate one with:  openssl rand -hex 32
#
# Required for event passwords. Without it, events can still be made, but
# setting or using a password answers 503.
#
# Never change it once events have passwords: every stored password stops
# matching, and those hosts are left with only the browser that made the
# event.

UWUHERE_PASSWORD_PEPPER=


# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <value>" when it runs the daily
# purge in vercel.json, and api/cron/purge.js refuses any call without it.
# Generate one with:  openssl rand -hex 32
#
# Required for the purge. Without it the cron job is refused and old events
# are never deleted; nothing else is affected.

CRON_SECRET=


# ---------------------------------------------------------------------------
# The Android app (android/, android/FIREBASE-SETUP.md)
# ---------------------------------------------------------------------------
# All three are optional. Without them the website, the PWA and the app all
# work; only the app's notifications are missing, and the update check is
# held to GitHub's 60 requests an hour, which the edge cache makes plenty.

# uwuHere's Firebase service account key, the whole JSON file pasted in (or
# base64 of it). Lets api/_lib/fcm.js send the app's notifications: check-ins
# to a host's events, and new versions. A password: anyone with it can push to
# every app in the UwU Apps Firebase project.
FIREBASE_SERVICE_ACCOUNT=

# Proves a "release published" call to /api/push/release came from GitHub.
# The same value goes in the GitHub webhook's Secret.
# Generate one with:  openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# A fine-grained GitHub token with public repositories, read-only, and nothing
# else. Raises GitHub's limit for /api/app-release from 60 to 5,000 an hour.
GITHUB_TOKEN=
