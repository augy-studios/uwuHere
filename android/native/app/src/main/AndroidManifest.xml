<?xml version="1.0" encoding="utf-8"?>
<!-- uwuHere for Android: see android/README.md for what each part is for. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Checking in by location, and a host setting the event's spot: the page's own
         Geolocation, which Capacitor's WebView asks Android for (main-site/js/geo.js). Only asked
         when somebody presses something that needs it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Check-ins to your events, new versions and news (Notifications.java), only once you turn
         them on with the bell in the Edge Tray. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app updating itself from GitHub (UpdateActivity.java). Each update still asks you on
         Android's own install screen. Not allowed on Google Play: drop it for a Play build. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Tapping phones: this phone answers as an NFC tag while a host page has it on
         (TapService.java). Granted at install, never asked. A phone without NFC still installs
         the app, and the host page says it can't take taps. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Checking in with no internet: this phone's own wifi hotspot, serving a check-in page
         (Hotspot.java), started only when the host asks. "Nearby devices" on Android 13 and later,
         asked then, and never used to find where anyone is; before 13, Android wants the location
         permission above for it instead. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Firebase's notifications use these unless the push names its own
             (main-site/api/_lib/fcm.js). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The site's own links open in the app, so a phone's camera scanning a host's QR
                 code lands on the check-in button here: Android checks the site lists this app's
                 signing key in main-site/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="here.uwuapps.org" />
            </intent-filter>

            <!-- uwu://here/ links (MainActivity.pageFor). Only the here host, so UwU Apps' other
                 apps can answer uwu:// links of their own. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uwu" android:host="here" />
            </intent-filter>
        </activity>

        <!-- The app updating itself, for the site's update bar and the Edge Tray's "Check for app
             updates" (UpdateActivity.java), and the installer's answers to it. Neither is
             exported: only this app starts them. -->
        <activity android:name=".UpdateActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/UpdateTheme" />
        <receiver android:name=".UpdateActivity$InstallStatus"
            android:exported="false" />

        <!-- Tapping phones. Disabled until a host page turns it on (TapService.start), so the app
             doesn't claim the NFC tag application when nobody is hosting. Exported for Android's
             NFC service, the only caller BIND_NFC_SERVICE lets in. -->
        <service android:name=".TapService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/tap_service" />
        </service>
    </application>
</manifest>
